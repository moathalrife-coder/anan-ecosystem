# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة: للخادم فقط، لا يُرسل للمتصفح أبداً
SUPABASE_SERVICE_ROLE_KEY=
# عنوان المنظومة (لروابط الدعوة واستعادة كلمة المرور)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
